#ifdef __spirv__
// DXC's SPIR-V back end does not implement _Static_assert: it fails with "decl type
// StaticAssert unimplemented". The DXIL back end does, so Windows keeps the check.
//
// These asserts only verify struct sizes at compile time, so dropping them changes no generated
// code. It does mean a size mismatch is caught on Windows and not on Linux, which is worth
// knowing when a struct layout changes.
#define HLSL_STATIC_ASSERT( X, Y )
#else
#define HLSL_STATIC_ASSERT( X, Y ) _Static_assert( X, Y )
#endif
#endif

