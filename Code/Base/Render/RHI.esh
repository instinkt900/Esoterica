#define EE_DECLARE_ROOT_CONSTANTS( Type, Register, Space )  ConstantBuffer<Type>        RootConstants : register( Register, Space )
#define EE_DECLARE_ROOT_CBV( Type, Register, Space )        ConstantBuffer<Type>        RootCBV : register( Register, Space )
#define EE_DECLARE_ROOT_SRV( Type, Register, Space )        StructuredBuffer<Type>      RootSRV : register( Register, Space )
