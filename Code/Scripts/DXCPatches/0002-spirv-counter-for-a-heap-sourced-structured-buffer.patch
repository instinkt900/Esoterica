+QualType SpirvEmitter::getDescriptorHeapResourceType(const Expr *expr) {
+  // heap[i] itself is typed as the heap's element placeholder; the resource
+  // type the access produces is on the implicit cast above it. This mirrors
+  // what the descriptor heap emission path in doCXXOperatorCallExpr does.
+  assert(isDescriptorHeap(expr));
+
+  if (const auto *parent = parentMap->getParent(expr))
+    if (const auto *castExpr = dyn_cast<CastExpr>(parent))
+      return castExpr->getType();
+
+  return expr->getType();
+}
