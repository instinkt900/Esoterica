+++ b/tools/clang/lib/SPIRV/SpirvEmitter.h
@@ -285,6 +285,9 @@
 
   bool isDescriptorHeap(const Expr *expr);
 
+  /// Returns the resource type that a descriptor heap access produces.
+  QualType getDescriptorHeapResourceType(const Expr *expr);
+
   void getDescriptorHeapOperands(const Expr *expr, const Expr **base,
                                  const Expr **index);
 
--- a/tools/clang/lib/SPIRV/SpirvEmitter.cpp
+++ b/tools/clang/lib/SPIRV/SpirvEmitter.cpp
@@ -3129,10 +3129,19 @@
