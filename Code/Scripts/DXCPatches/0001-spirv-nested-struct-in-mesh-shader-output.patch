     const llvm::SmallVector<SpirvInstruction *, 4> &indices) {
   assert(spvContext.isMS() && !indices.empty());
 
+  auto semanticInfo = declIdMapper.getStageVarSemantic(decl);
+  const auto loc = decl->getLocation();
+
+  // A member whose type is itself a struct has no stage variable of its own:
+  // DeclResultIdMapper::createStructOutputVar flattens it and records one
+  // stage variable per leaf field. Mirror that flattening here, the way
+  // writeBackOutputStream does for geometry shader output streams. Without
+  // this we look up a stage variable that was never recorded and store
+  // through the null pointer that comes back.
+  //
+  // The test is the type alone, and deliberately not the semantic.
+  // createStageVars maps a decl to a single stage variable only when it has a
+  // semantic *and* is not a structure type, so a struct member carrying a
+  // semantic of its own is flattened too, with its members inheriting that
+  // semantic at increasing indices.
+  if (decl->getType()->isStructureType()) {
+    const QualType declType = decl->getType();
+
+    // The AST field index is not the index to extract with. Bitfields are
+    // merged into one member when the struct is lowered, so several AST fields
+    // can share a SPIR-V member, and every later field is shifted down.
+    // FieldInfo::fieldIndex carries the lowered index, and getFieldIndexInStruct
+    // is the same lookup collectArrayStructIndices uses.
+    LowerTypeVisitor lowerTypeVisitor(astContext, spvContext, spirvOptions,
+                                      spvBuilder);
+    const StructType *spirvStructType =
+        lowerStructType(spirvOptions, lowerTypeVisitor, declType);
+    assert(spirvStructType != nullptr);
+
+    const auto *structDecl = declType->getAs<RecordType>()->getDecl();
+    for (const auto *field : structDecl->fields()) {
+      const uint32_t indexAST =
+          getNumBaseClasses(declType) + field->getFieldIndex();
+      const auto &spirvField = spirvStructType->getFields()[indexAST];
+
+      SpirvInstruction *subValue = spvBuilder.createCompositeExtract(
+          field->getType(), value, {spirvField.fieldIndex}, loc);
+
+      // Extracting a bitfield yields the whole merged member, so take the
+      // field's own bits back out of it. A stage variable was created per AST
+      // field, so each bitfield is written separately.
+      if (spirvField.bitfield.hasValue()) {
+        subValue = spvBuilder.createBitFieldExtract(
+            field->getType(), subValue, spirvField.bitfield->offsetInBits,
+            spirvField.bitfield->sizeInBits, loc, {});
+      }
+
+      assignToMSOutAttribute(field, subValue, indices);
+    }
+    return;
+  }
+
   // Extract attribute index and vecComponent (if any).
   SpirvInstruction *attrIndex = indices.front();
   SpirvInstruction *vecComponent = nullptr;
