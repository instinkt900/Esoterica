+// Returns the AST type of the struct member that holds the bitfield at
+// indexAST. Merged bitfields share a member, and the member takes the type of
+// the first field in the group, so walk back to it.
+QualType SpirvEmitter::getBitfieldMemberType(QualType baseType,
+                                             const StructType *spirvStructType,
+                                             uint32_t indexAST) {
+  const auto &fields = spirvStructType->getFields();
+  uint32_t first = indexAST;
+  while (first > 0 &&
+         fields[first - 1].fieldIndex == fields[indexAST].fieldIndex) {
+    --first;
+  }
+
+  if (first == indexAST)
+    return getFieldTypeByAstIndex(baseType, indexAST);
+
+  return getFieldTypeByAstIndex(baseType, first);
+}
+
+// Returns the declared type of the field at the given flattened AST index.
+QualType SpirvEmitter::getFieldTypeByAstIndex(QualType baseType,
+                                              uint32_t indexAST) {
+  const auto *recordType = baseType->getAs<RecordType>();
+  assert(recordType);
+  const uint32_t numBases = getNumBaseClasses(baseType);
+
+  uint32_t i = numBases;
+  for (const auto *field : recordType->getDecl()->fields()) {
+    if (i == indexAST)
+      return field->getType();
+    ++i;
+  }
+
+  llvm_unreachable("bitfield index out of range");
+}
