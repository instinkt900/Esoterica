+namespace {
+/// True when two bitfield base types differ only in signedness, and so may share
+/// one merged member. Compared on the lowered representation - width and
+/// signedness - so that this matches what LowerTypeVisitor does with the SPIR-V
+/// types, including for enums, which lower to plain integers.
+bool isMergeableBitfieldPair(const clang::ASTContext &astContext,
+                             clang::QualType a, clang::QualType b) {
+  if (!a->isIntegralOrEnumerationType() || !b->isIntegralOrEnumerationType())
+    return false;
+  if (astContext.getTypeSize(a) != astContext.getTypeSize(b))
+    return false;
+  return true;
+}
