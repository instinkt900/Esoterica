
#include "Engine/Render/Shaders/Renderer/RendererTypes.esh"
#include "Engine/Render/Shaders/Renderer/RendererSurfaceShaderLayout.esh"
#include "Engine/Render/Shaders/EngineShader.esh"
#include "Engine/Render/Shaders/MeshInstance.esh"

ESF_PARAMETER string ShaderType = "Compute";

EE_DECLARE_INDIRECT_ROOT_CONSTANTS( ClusterCullingRootConstants, b0, space0 );
EE_DECLARE_INDIRECT_ROOT_CBV( GlobalParameters, b1, space0 );

// Reached only by an indirect dispatch, so the root arguments are read out of the argument
// buffer. See EE_DECLARE_INDIRECT_ROOT_CONSTANTS in RHI.esh; the bodies below do not change.
#ifdef __spirv__
#define RootConstants EE_g_RootConstants
#define RootCBV       EE_g_RootCBV
#endif

groupshared uint64_t2 gsBucketMasks[EE_MAX_CULLING_VIEWS][3]; // 128-bit visibility mask per ( view, sub-bucket ) - 1 bit per cluster record in the culling group

[RootSignature( ClusterCullingRootSignature )]
[numthreads( 128, 1, 1 )]
void CS_main( uint groupID : SV_GroupID, uint groupThreadID : SV_GroupThreadID, uint3 dispatchThreadID : SV_DispatchThreadID EE_INDIRECT_DISPATCH_ENTRY_ARGS )
{
    EE_INDIRECT_DISPATCH_ENTRY_INIT

    StructuredBuffer<RenderView>            renderViewBuffer            = GetBuffer( RootCBV.m_renderViewBuffer );
    StructuredBuffer<MeshInstance>          meshInstanceBuffer          = GetBuffer( RootCBV.m_meshInstanceBuffer );
    ByteAddressBuffer                       meshInstanceRootBuffer      = GetBuffer( RootCBV.m_meshInstanceRootBuffer );
    StructuredBuffer<MeshCluster>           clusterBuffer               = GetBuffer( RootCBV.m_clusterBuffer );
    Buffer<uint4>                           clusterRecordBuffer          = GetBuffer( RWBufferToBuffer( RootCBV.m_ClusterRecordBuffer ) );
    StructuredBuffer<RenderBucket>          renderBucketBuffer          = GetBuffer( RootCBV.m_renderBucketBuffer );
    ByteAddressBuffer                       shaderDataBuffer            = GetBuffer( RootCBV.m_shaderDataBuffer );

    const uint                              recordIndex                 = RootConstants.m_clusterRangeStart + dispatchThreadID.x;
    const bool                              inRange                     = recordIndex < RootConstants.m_clusterRangeEnd;

    const uint64_t2                         recordBit                   = uint64_t2
    (
        groupThreadID < 64 ? 1ULL << groupThreadID : 0,
        groupThreadID >= 64 ? 1ULL << ( groupThreadID - 64 ) : 0
    );

    //-------------------------------------------------------------------------

    uint64_t                                viewMask                    = 0;
    float3                                  clusterCenterGlobal         = 0.0.xxx;
    float3                                  clusterExtentGlobal         = 0.0.xxx;
    bool                                    isSkinned                   = false;

    ShaderParameters                        shaderParameters            = ( ShaderParameters )0;

    // Reset the per-view bucket masks
    //-------------------------------------------------------------------------
    
    for ( uint viewIndex = groupThreadID; viewIndex < EE_MAX_CULLING_VIEWS; viewIndex += 128 )
    {
        gsBucketMasks[viewIndex][0] = uint64_t2( 0, 0 );
        gsBucketMasks[viewIndex][1] = uint64_t2( 0, 0 );
        gsBucketMasks[viewIndex][2] = uint64_t2( 0, 0 );
    }
    
    GroupMemoryBarrierWithGroupSync();

    if ( inRange )
    {
        const uint4                         clusterRecord               = clusterRecordBuffer[recordIndex];

        const MeshCluster                   cluster                     = clusterBuffer[clusterRecord.y];
        const MeshInstance                  meshInstance                = meshInstanceBuffer[clusterRecord.x];

        uint                                meshInstanceDataAddress;
        const MeshInstanceRoot              meshInstanceRoot            = meshInstance.LoadRoot( meshInstanceRootBuffer, meshInstanceDataAddress );
        
        shaderParameters    = shaderDataBuffer.Load<ShaderParameters>( meshInstance.m_shaderParametersOffsetIn32ByteBlocks * 32 );
        viewMask            = uint64_t( clusterRecord.z ) | ( uint64_t( clusterRecord.w ) << 32 );
        isSkinned           = meshInstanceRoot.m_boneOffset != ~0U;

        // Skinned clusters use the root bounds
        if ( !isSkinned )
        {
            const float3x4  meshInstanceTransform   = meshInstance.ComputeWorldTransform( meshInstanceRoot );
            const float4    boundingSphere          = cluster.GetBoundingSphere();
            
            TransformAABB( meshInstanceTransform, boundingSphere.xyz, boundingSphere.www, clusterCenterGlobal, clusterExtentGlobal );
        }

        // Cull in all views
        //-------------------------------------------------------------------------

        for ( uint viewIndex = 0; viewIndex < RootConstants.m_commonRootConstants.m_numRenderViews; ++viewIndex )
        {
            const RenderView renderView = renderViewBuffer[viewIndex];

            bool visibleInThisView = ( viewMask & ( 1ULL << viewIndex ) ) != 0;

            // Skinned clusters use the root bounds - don't cull them per-cluster, only filter them by bucket
            if ( visibleInThisView && !isSkinned )
            {
                float4 viewPlanes[6];
                renderView.ComputeViewPlanes( viewPlanes );

                visibleInThisView = IsFrustumVisible( clusterCenterGlobal, clusterExtentGlobal, viewPlanes );

                if ( visibleInThisView )
                {
                    float4 projectedAABB = 0.0.xxxx;
                    if ( renderView.ProjectBox( clusterCenterGlobal, clusterExtentGlobal, projectedAABB ) )
                    {
                        const float width  = ( projectedAABB.z - projectedAABB.x ) * renderView.m_renderTargetSize.x;
                        const float height = ( projectedAABB.w - projectedAABB.y ) * renderView.m_renderTargetSize.y;

                        // Size is less than 2 pixels -> cull
                        if ( width < 2.0 && height < 2.0 )
                        {
                            visibleInThisView = false;
                        }
                    }
                }
            }

            if ( visibleInThisView )
            {
                const bool renderViewDepthOnly = ( renderView.m_renderViewFlags & RENDER_VIEW_FLAG_DEPTH_ONLY ) != 0;
                const uint subBucket = GetBucketTypeForView( shaderParameters, renderViewDepthOnly );

                InterlockedOr( gsBucketMasks[viewIndex][subBucket].x, recordBit.x );
                InterlockedOr( gsBucketMasks[viewIndex][subBucket].y, recordBit.y );
            }
        }
    }

    GroupMemoryBarrierWithGroupSync();

    // Emit one draw argument per ( view, sub-bucket ) with a 128-bit visibility mask
    //-------------------------------------------------------------------------

    if ( groupThreadID < RootConstants.m_commonRootConstants.m_numRenderViews )
    {
        const uint viewIndex  = groupThreadID;
        const uint bucketBase = viewIndex * RootConstants.m_commonRootConstants.m_numRenderViewBucketsPerView + RootConstants.m_shaderIndex * 3;

        for ( uint subBucket = 0; subBucket < 3; ++subBucket )
        {
            const uint64_t2 mask = gsBucketMasks[viewIndex][subBucket];
            if ( mask.x == 0 && mask.y == 0 )
            {
                continue;
            }

            const RenderBucket renderBucket = renderBucketBuffer[bucketBase + subBucket];

            RWBuffer<uint> drawArgumentCounter = GetRWBuffer( NonUniformResourceIndex( renderBucket.m_drawCounterBuffer ) );

            uint drawArgumentIndex = 0;
            InterlockedAdd( drawArgumentCounter[0], 1, drawArgumentIndex );

            RWStructuredBuffer<DrawArgument> drawArgumentBuffer = GetRWBuffer( NonUniformResourceIndex( renderBucket.m_drawArgumentBuffer ) );

            DrawArgument drawArgument = ( DrawArgument )0;
            drawArgument.m_rootConstants.m_commonRootConstants = RootConstants.m_commonRootConstants;
            drawArgument.m_rootConstants.m_clusterRecordBase  = RootConstants.m_clusterRangeStart + groupID * 128;
            drawArgument.m_rootConstants.m_renderViewIndex    = viewIndex;
            drawArgument.m_rootConstants.m_clusterMask0       = uint( mask.x );
            drawArgument.m_rootConstants.m_clusterMask1       = uint( mask.x >> 32 );
            drawArgument.m_rootConstants.m_clusterMask2       = uint( mask.y );
            drawArgument.m_rootConstants.m_clusterMask3       = uint( mask.y >> 32 );
            drawArgument.m_rootCBV                            = RootCBV.m_deviceAddress;
            drawArgument.m_dispatchArguments                  = uint3( CountBits128( mask ), 1, 1 );

            drawArgumentBuffer[drawArgumentIndex] = drawArgument;
        }
    }
}
