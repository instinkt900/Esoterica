#ifndef __cplusplus
#define RWStructuredBuffer RWBuffer
#define FFX_HLSL
#include "FFX_ParallelSort.esh"
#undef RWStructuredBuffer
#endif

#include "Base/Render/RHI.esh"

#ifndef __cplusplus
ESF_RESOURCE_TABLE struct FFX_ParallelSort_ScanResourceTable
{
    RWBuffer<uint>  m_scanSrc;
    RWBuffer<uint>  m_scanDst;
};
#endif

#include "Engine/_Module/_AutoGenerated/ShaderReflection/FFX_ParallelSort_Scan.esh"

ESF_PARAMETER string ShaderType = "Compute";

#define FFX_ScanRootSignature   EE_BEGIN_ROOT_SIGNATURE \
                                FFX_ParallelSort_ScanResourceTableRootConstant( "b0", "space=0" ) \
                                "CBV( b1, space = 0 )"

EE_DECLARE_ROOT_CONSTANTS( FFX_ParallelSort_ScanResourceTableData, b0, space0 );
EE_DECLARE_ROOT_CBV( FFX_ParallelSortCB, b1, space0 );

//-------------------------------------------------------------------------

[RootSignature( FFX_ScanRootSignature )]
[numthreads( 128, 1, 1 )]
void CS_main( uint localID : SV_GroupThreadID, uint groupID : SV_GroupID )
{
    FFX_ParallelSort_ScanResourceTable resourceTable = CreateFFX_ParallelSort_ScanResourceTable( RootConstants );

    FFX_ParallelSort_ScanPrefix( RootCBV.NumScanValues, localID, groupID, 0, 0, false, RootCBV, resourceTable.m_scanSrc, resourceTable.m_scanDst, resourceTable.m_scanDst );
}
